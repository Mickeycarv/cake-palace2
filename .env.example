# Copy this file to .env (which is git-ignored) when the real integrations are added.
# Nothing in v1 reads these values — the site runs fully on sample data.
# Never commit a real .env file or paste real keys into the code.

# --- Razorpay (online payments) ---
# The public key id can be exposed to the browser; the secret must stay server-side only.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=server-side-only-never-in-the-browser

# --- WhatsApp Business API (order alerts to the shop / customer) ---
# Server-side only (Cloudflare Worker secret: `npx wrangler secret put WHATSAPP_API_TOKEN`).
# WHATSAPP_API_TOKEN=xxxxxxxxxxxxxxxxxxxx
# WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxx
