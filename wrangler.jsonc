{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers Static Assets: serves the Vite build from ./dist.
  // No Worker script is needed — "single-page-application" returns index.html
  // for unknown paths so React Router handles /menu, /admin, /order/:id etc.
  "name": "cake-palace2",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
  // TODO (later): add a Worker script ("main") for Razorpay order creation /
  // signature verification and WhatsApp alerts, with secrets set via `wrangler secret put`.
}
